# Google Gemini API Key (Required for Google ADK & Gemini)
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model for Google ADK
FOODY_MODEL=gemini-3.5-flash-lite

# Telegram Bot Token (Required for run_telegram.py, optional if only using `adk web`)
# Create a bot via @BotFather on Telegram -> /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Restrict Telegram Bot to your personal Telegram user ID (leave blank to allow your chat)
ALLOWED_TELEGRAM_USER_IDS=

# Default Swiggy Delivery Address ID (Pre-configured to Office — Nariman Point, Mumbai)
DEFAULT_ADDRESS_ID=d96vons1d96q25a1vd6g__ASDDdwRXLVoelNROTOQ0xA
DEFAULT_ADDRESS_LABEL=Office — Nariman Point, Mumbai

# Path to Swiggy CLI OAuth store (auto-detected from ~/.swiggy/auth.json if left blank)
SWIGGY_AUTH_PATH=
